{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Studio Kassenplatz",
  "version": "0.3.0",
  "identifier": "de.kisunlounge.studiokassenplatz",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["lokal"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Studio",
    "shortDescription": "Studio-Kassenplatz",
    "longDescription": "Theke, Self-Service-Kiosk und Verfügbarkeitsanzeige für den Studio-Server",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German"],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFMUY0MjNCMTE2M0YyREQKUldUZDhtTVJPMElmYmhZd2greHZBTGtJSVhjV1h6Qk04YWpXZ2RuQ0hRZnFUSmdNYjROdG1QRSsK",
      "endpoints": ["https://github.com/boeckmannniklas-web/studio-tauri/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
